load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

proto_library(
    name = "compiler_state_proto",
    srcs = ["compiler_state.proto"],
    deps = [
        "//src/com/google/javascript/jscomp/conformance:conformance_proto",
    ],
)

java_proto_library(
    name = "compiler_state_java_proto",
    deps = [":compiler_state_proto"],
)
